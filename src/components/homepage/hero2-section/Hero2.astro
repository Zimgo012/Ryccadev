---
import "../../../styles/homepage/hero2-section/hero2.css"
import Window2 from '../../Window2.astro';
import SideScroll from "./SideScroll.astro";
import FilePane from "./FilePane.astro";
import Preview from "./Preview.astro";

import { getCollection } from "astro:content";
const projects = await getCollection("projects");
const blogs = await getCollection("blogs");

---
<div class="hero2">
    <div class="hero2-content">

            <Window2>
              <div class="inside-content">
                  <SideScroll/>
                  <FilePane
                          collections={{
                              projects,
                              blogs,
                          }}
                  />
                  <Preview/>
              </div>
            </Window>
    </div>

</div>