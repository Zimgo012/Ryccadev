---
import "../../../styles/homepage/hero2-section/filepane.css";
import { sections } from "../../../config/sections";
import {ROUTES} from "../../../config/routes";
const { collections } = Astro.props;
---

<div class="file-pane" id="filePane"></div>

<script define:vars={{ collections, sections, ROUTES }}>

    const filePane = document.getElementById("filePane");

    let previewWindow;
    let previewTitle;
    let previewBody;
    let activeFile = null;

    function getPreview() {
        previewWindow = document.getElementById("previewWindow");
        previewTitle = document.getElementById("previewTitle");
        previewBody = document.getElementById("previewBody");
    }

    getPreview();

    function setActive(div) {
        if (activeFile) {
            activeFile.classList.remove("active");
        }

        div.classList.add("active");
        activeFile = div;
    }

    function showPreview(title, html, div) {

        getPreview();

        if (!previewWindow) return;

        previewWindow.style.display = "flex";
        previewTitle.textContent = "Preview";
        previewBody.innerHTML = html;

        // Position using viewport coordinates — the window is position:fixed
        const rect = div.getBoundingClientRect();
        const vpW  = window.innerWidth;
        const vpH  = window.innerHeight;

        const previewW = previewWindow.offsetWidth || 480;
        const previewH = previewWindow.offsetHeight || 280;

        // Try to the right of the clicked item; fall back to the left
        let left = rect.right + 12;
        if (left + previewW > vpW - 12) {
            left = rect.left - previewW - 12;
        }
        // Clamp to viewport edges
        left = Math.max(12, Math.min(left, vpW - previewW - 12));

        // Align top to the clicked item, but keep within viewport
        let top = rect.top;
        top = Math.max(12, Math.min(top, vpH - previewH - 12));

        previewWindow.style.left = `${left}px`;
        previewWindow.style.top  = `${top}px`;
    }

    function renderFiles(sectionKey) {

        const config = sections[sectionKey];

        if (!config) return;

        filePane.innerHTML = "";

        const icon = config.icon;

        /* =====================================================
           PROJECTS (JSON DATABASE)
        ===================================================== */

        if (sectionKey === "projects") {

            const projectFile =
                collections?.projects?.[0];

            const projects =
                projectFile?.data?.projects ?? [];

            if (!projects.length) {
                filePane.innerHTML = "<p>No projects found.</p>";
                return;
            }

            projects.forEach((project) => {

                const div = document.createElement("div");
                div.className = "file-item";

                div.innerHTML = `
                    <img src="${icon}" width="40"/>
                    <span>${project.name}</span>
                `;

                console.log(project);

                div.addEventListener("click", () => {

                    setActive(div);

                    showPreview(
                        project.name,
                        `
    <div class="title">
        <h2>${project.name}</h2>
    </div>

    <br/>

    <p>${project.summary ?? ""}</p>

    ${
                            project.technologies?.length
                                ? `
            <br/>

            <div class="tech-section">
                <div class="tech-list">
                    ${project.technologies
                                    .map(
                                        tech => `<span class="tech-badge">${tech}</span>`
                                    )
                                    .join("")}
                </div>
            </div>
            `
                                : ""
                        }

    <br/>

    <div class="prev-links">
        ${
                            project.projectlink
                                ? `
                <a
                    href="${project.projectlink}"
                    target="_blank"
                    class="link-item">
                    Open Project
                </a>
                `
                                : ""
                        }

        ${
                            project.blogLink && project.blogLink !== "none"
                                ? `
                <a
                    href="${ROUTES.blogs}/${project.blogLink}"
                    class="link-item">
                    Project Blog
                </a>
                `
                                : ""
                        }
    </div>
    `,
                        div
                    );
                });

                filePane.appendChild(div);
            });

            return;
        }

        /* =====================================================
           BLOGS (MARKDOWN COLLECTION)
        ===================================================== */

        const files =
            collections?.[config.collection] ?? [];

        if (!files.length) {
            filePane.innerHTML = "<div class=\"file-item\">\n" +
                "    No files found.\n" +
                "</div>";
            return;
        }

        files.forEach((file) => {

            const data = file.data;

            const title =
                data.title ??
                data.name ??
                file.id;

            const div = document.createElement("div");

            div.className = "file-item";

            div.innerHTML = `
                <img src="${icon}" width="40"/>
                <span>${title}</span>
            `;

            div.addEventListener("click", () => {

                setActive(div);

                showPreview(
                    title,
                    `
                    <div class="title">
                        <h2>${title}</h2>
                    </div>

                
                    
                    ${data.summary ? `<p>${data.summary}</p>` : ""}
                    <br/>
                    
                    ${data.author
                        ? `<p><strong>Author:</strong> ${data.author}</p>`
                        : ""
                    }
                    ${data.date ? `<p> <strong>Date published: </strong>${data.date}</p>` : ""}
                    <br/>
                    ${
                        data.tags?.length
                            ? `
        <div class="tags-section">

            <div class="tags-list">
                ${data.tags
                                .map(
                                    (tag) => `<span class="tag-badge">${tag}</span>`
                                )
                                .join("")}
            </div>
        </div>

        <br/>
        `
                            : ""
                    }

                    <div class="prev-links">
                        <p>
                            <a
                                href="${ROUTES.blogs}/${file.id}"
                                class="link-item">
                                Read Blog
                            </a>
                        </p>
                    </div>
                    `,
                    div
                );
            });

            filePane.appendChild(div);
        });
    }

    window.addEventListener("section-change", (e) => {
        renderFiles(e.detail);
    });

    // Render the first section (projects) immediately on load
    // so the pane isn't empty if the section-change event fires before this listener registers
    renderFiles(Object.keys(sections)[0]);

</script>