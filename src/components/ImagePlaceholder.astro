---
/**
 * ImagePlaceholder — blueprint-style image frame.
 * Thin border box with corner bracket marks and a crosshair + label center.
 * Theme-aware via CSS custom properties.
 *
 * Props:
 *   width?        — CSS width value (default: '100%')
 *   height?       — CSS height value (default: same as width)
 *   label?        — center label text (default: 'IMAGE')
 *   bracketSize?  — corner bracket arm length in px (default: 16)
 *   bracketWeight?— corner bracket line thickness in px (default: 1.5)
 *   id?           — forwarded to root element
 *   class?        — extra classes on root element
 */
interface Props {
  width?:         string | number;
  height?:        string | number;
  label?:         string;
  bracketSize?:   number;
  bracketWeight?: number;
  id?:            string;
  class?:         string;
}

const {
  width         = '100%',
  height,
  label         = 'IMAGE',
  bracketSize   = 16,
  bracketWeight = 1.5,
  id,
  class: className = '',
} = Astro.props;

// Resolve width/height to CSS strings
const w = typeof width  === 'number' ? `${width}px`  : width;
const h = typeof height === 'number' ? `${height}px` : (height ?? w);

const bs = bracketSize;
const bw = bracketWeight;
---

<div
  class:list={['img-placeholder', className]}
  id={id}
  style={`width:${w};height:${h};--bs:${bs}px;--bw:${bw}px;`}
>
  {/* Thin outer border */}
  <div class="ip-border" aria-hidden="true"></div>

  {/* Corner brackets — one div per corner */}
  <div class="ip-corner ip-corner--tl" aria-hidden="true"></div>
  <div class="ip-corner ip-corner--tr" aria-hidden="true"></div>
  <div class="ip-corner ip-corner--bl" aria-hidden="true"></div>
  <div class="ip-corner ip-corner--br" aria-hidden="true"></div>

</div>

<style>
  .img-placeholder {
    position: relative;
    //background: url("../../src/resources/Ry.png");
    overflow: hidden;
    background-size: 230px 230px;
  }

  /* Thin 1px outer border */
  .ip-border {
    position: absolute;
    inset: 0;
    border: 1px solid var(--ml-outline-variant, #444748);
    pointer-events: none;
  }

  /* Corner brackets — two-sided border trick */
  .ip-corner {
    position: absolute;
    width: var(--bs);
    height: var(--bs);
    pointer-events: none;
  }

  .ip-corner--tl {
    top: 0; left: 0;
    border-top:  var(--bw) solid var(--ml-primary, #ffffff);
    border-left: var(--bw) solid var(--ml-primary, #ffffff);
  }
  .ip-corner--tr {
    top: 0; right: 0;
    border-top:   var(--bw) solid var(--ml-primary, #ffffff);
    border-right: var(--bw) solid var(--ml-primary, #ffffff);
  }
  .ip-corner--bl {
    bottom: 0; left: 0;
    border-bottom: var(--bw) solid var(--ml-primary, #ffffff);
    border-left:   var(--bw) solid var(--ml-primary, #ffffff);
  }
  .ip-corner--br {
    bottom: 0; right: 0;
    border-bottom: var(--bw) solid var(--ml-primary, #ffffff);
    border-right:  var(--bw) solid var(--ml-primary, #ffffff);
  }

  /* Center content */
  .ip-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    pointer-events: none;
  }

  .ip-crosshair {
    opacity: 0.3;
    display: block;
  }

  .ip-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ml-outline, #8e9192);
  }
</style>
