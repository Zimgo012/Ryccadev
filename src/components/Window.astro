---
import '../styles/window.css'


const {profile} = Astro.props
---

<div class="window">
    <!--TITLE BAR-->
    <div class="window-title-gradient ">
        <div class="">
            <span >C:\PROFILE\{profile ? profile : "NAN"}.EXE</span>
        </div>
        <div class="titlebar">
            <button class="win98-button ">_</button>
            <button class="win98-button ">□</button>
            <button class="win98-button ">×</button>
        </div>

    </div>

    <slot/>


</div>
