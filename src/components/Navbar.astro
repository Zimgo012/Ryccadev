---
import "../styles/navbar.css"

import {ROUTES} from "../config/routes"
---

<nav class="nav" id="nav">
    <a href={ROUTES.home} class="nav-logo mono">RYCCA.DEV</a>
    <div class="nav-links">
        <a href={ROUTES.home} class="nav-link mono">Home</a>
        <a href={ROUTES.projects} class="nav-link mono">Projects</a>
        <a href={ROUTES.blogs} class="nav-link mono">Blogs</a>
    </div>

    <div class="nav-right-side">
        <button class="theme-btn mono" id="themeToggle">

        </button>
        <!--Version Badge-->
        <p class="version-num">v1.0</p>
    </div>

</nav>


<script>

    // ── Theme state ────────────────────────────────────────────────
    const toggle = document.getElementById('themeToggle') as HTMLButtonElement;
    const nav    = document.getElementById('nav') as HTMLElement;

    const stored = localStorage.getItem('ml-theme');
    let isLight = stored === 'light'
        ? true
        : stored === 'dark'
            ? false
            : window.matchMedia('(prefers-color-scheme: light)').matches;

    function applyTheme(light: boolean) {
        document.documentElement.setAttribute('data-theme', light ? 'light' : 'dark');
        toggle.textContent = light ? '○' : '◉';
        localStorage.setItem('ml-theme', light ? 'light' : 'dark');
    }

    applyTheme(isLight);

    toggle.addEventListener('click', () => {
        isLight = !isLight;
        applyTheme(isLight);
    });

    // Shrink nav on scroll
    window.addEventListener('scroll', () => {
        nav.classList.toggle('nav--scrolled', window.scrollY > 40);
    }, { passive: true });

</script>
