---
/**
 * GradientBackground
 * Theme-aware gradient backdrop using an inline SVG.
 * Blur is a soft feGaussianBlur vignette baked into the SVG itself.
 *
 * Props:
 *   variant? — 'radial' | 'linear-tb' | 'linear-br' (default: 'radial')
 *   blur?    — vignette blur intensity in px (default: 60). 0 = no blur.
 *   class?   — extra classes on the root div
 */
interface Props {
  variant?: 'radial' | 'linear-tb' | 'linear-br';
  blur?:    number;
  id?:      string;
  class?:   string;
}

const { variant = 'radial', blur = 60, id, class: className = '' } = Astro.props;

const uid     = `gb-${variant}-${Math.random().toString(36).slice(2, 6)}`;
const darkId  = `${uid}-dark`;
const lightId = `${uid}-light`;
const maskId  = `${uid}-mask`;
const filtId  = `${uid}-blur`;
---

<div class:list={['gradient-bg-root', className]} style="position:relative;" id={id}>
  <svg
    aria-hidden="true"
    width="100%"
    height="100%"
    style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0;"
    preserveAspectRatio="none"
  >
    <defs>
      {variant === 'radial' && (
        <>
          <radialGradient id={darkId}  cx="50%" cy="0%" r="60%" fx="50%" fy="0%" gradientUnits="objectBoundingBox">
            <stop offset="0%"   stop-color="#292a2a" />
            <stop offset="100%" stop-color="#121414" />
          </radialGradient>
          <radialGradient id={lightId} cx="50%" cy="0%" r="60%" fx="50%" fy="0%" gradientUnits="objectBoundingBox">
            <stop offset="0%"   stop-color="#ffffff" />
            <stop offset="100%" stop-color="#e3e3e3" />
          </radialGradient>
        </>
      )}
      {variant === 'linear-tb' && (
        <>
          <linearGradient id={darkId}  x1="0" y1="0" x2="0" y2="1" gradientUnits="objectBoundingBox">
            <stop offset="0%"   stop-color="#1f2020" />
            <stop offset="100%" stop-color="#121414" />
          </linearGradient>
          <linearGradient id={lightId} x1="0" y1="0" x2="0" y2="1" gradientUnits="objectBoundingBox">
            <stop offset="0%"   stop-color="#ffffff" />
            <stop offset="100%" stop-color="#d5d5d5" />
          </linearGradient>
        </>
      )}
      {variant === 'linear-br' && (
        <>
          <linearGradient id={darkId}  x1="0" y1="0" x2="1" y2="1" gradientUnits="objectBoundingBox">
            <stop offset="0%"   stop-color="#292a2a" />
            <stop offset="100%" stop-color="#0d0e0f" />
          </linearGradient>
          <linearGradient id={lightId} x1="0" y1="0" x2="1" y2="1" gradientUnits="objectBoundingBox">
            <stop offset="0%"   stop-color="#ffffff" />
            <stop offset="100%" stop-color="#c8cccc" />
          </linearGradient>
        </>
      )}

      {blur > 0 && (
        <>
          <radialGradient id={`${maskId}-grad`} cx="50%" cy="50%" r="50%">
            <stop offset="0%"   stop-color="white" stop-opacity="1" />
            <stop offset="55%"  stop-color="white" stop-opacity="1" />
            <stop offset="100%" stop-color="white" stop-opacity="0" />
          </radialGradient>
          <mask id={maskId}>
            <rect width="100%" height="100%" fill={`url(#${maskId}-grad)`} />
          </mask>
          <filter id={filtId} x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation={blur} />
          </filter>
        </>
      )}
    </defs>

    {/* Dark base */}
    <rect class="grad-dark"  width="100%" height="100%" fill={`url(#${darkId})`}  />
    {/* Light base — fades in on .light parent */}
    <rect class="grad-light" width="100%" height="100%" fill={`url(#${lightId})`} />

    {/* Blurred edge vignette overlays */}
    {blur > 0 && (
      <>
        <rect class="grad-dark"  width="100%" height="100%" fill={`url(#${darkId})`}  filter={`url(#${filtId})`} mask={`url(#${maskId})`} opacity="0.6" />
        <rect class="grad-light" width="100%" height="100%" fill={`url(#${lightId})`} filter={`url(#${filtId})`} mask={`url(#${maskId})`} opacity="0.6" />
      </>
    )}
  </svg>

  <div style="position:relative;z-index:1;">
    <slot />
  </div>
</div>

<style>
  .grad-dark  { opacity: 1; transition: opacity 0.15s; }
  .grad-light { opacity: 0; transition: opacity 0.15s; }

  :global(.light) .grad-dark  { opacity: 0; }
  :global(.light) .grad-light { opacity: 1; }
</style>
