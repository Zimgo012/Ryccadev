---
import '../../styles/projects/projectlist.css'
import BaseLayout from "../../layouts/BaseLayout.astro";
import Window2 from "../../components/Window2.astro";
import { getCollection } from "astro:content";

const projectFiles = await getCollection("projects");

const projects = projectFiles.flatMap(
    (file) => file.data.projects ?? []
);
---

<BaseLayout webtitle="Projects">
    <div class="project-list-main">

        <Window2 profile="projects">

            <div class="project-list-content">

                {projects.map((project) => (

                        <div class="project-list-item">

                            {/* RIGHT SIDE */}
                            <div class="project-info">

                                <h2>{project.name}</h2>

                                {project.summary && (
                                        <p>{project.summary}</p>
                                )}

                                <br />

                                <div class="link-section">

                                    {project.blogLink && project.blogLink !== "none" && (
                                            <a
                                                    class="blog-link"
                                                    href={project.blogLink}
                                            >
                                                Read blog about this project
                                            </a>
                                    )}

                                    {project.projectlink && (
                                            <a
                                                    class="blog-link"
                                                    href={project.projectlink}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                            >
                                                Open Project
                                            </a>
                                    )}

                                </div>

                            </div>

                            <div class="project-tech">
                                {project.technologies?.length ? (
                                    project.technologies.map((tech) => (
                                            <span class="tech-badge">{tech}</span>
                                    ))
                                ) : (
                                        <span class="tech-empty">No tech listed</span>
                                )}
                            </div>

                        </div>

                ))}

            </div>

        </Window2>

    </div>
</BaseLayout>