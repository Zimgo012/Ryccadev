---
import '../styles/global.css';
import CrossPattern       from '../components/background/CrossPattern.astro';
import DotPattern         from '../components/background/DotPattern.astro';
import GradientBackground from '../components/background/GradientBackground.astro';
import GridPattern        from '../components/background/GridPattern.astro';
import DoubleArrow        from '../components/DoubleArrow.astro';
import ImagePlaceholder   from '../components/ImagePlaceholder.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Rycca Belcina — Backend Engineer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body id="body">

    <!-- ── NAV ─────────────────────────────────────────────────── -->
    <nav class="nav" id="nav">
      <a href="#hero" class="nav-logo mono">RB.DEV</a>
      <div class="nav-links">
        <a href="#about"    class="nav-link mono">_about</a>
        <a href="#projects" class="nav-link mono">_projects</a>
        <a href="#skills"   class="nav-link mono">_skills</a>
        <a href="#contact"  class="nav-link mono">_contact</a>
      </div>
      <button class="theme-btn mono" id="themeToggle">[DARK]</button>
    </nav>

    <!-- ══════════════════════════════════════════════════════════
         HERO — CrossPattern
    ═══════════════════════════════════════════════════════════ -->
    <CrossPattern count={56} seed={7} fade={0.7} class="section hero-section" id="hero">
      <div class="container hero-inner">
        <div class="hero-meta">
          <span class="mono label">AVAILABLE FOR WORK</span>
          <span class="status-dot"></span>
        </div>
        <h1 class="hero-title">
          Rycca<br />Belcina
        </h1>
        <p class="hero-role mono">Backend Engineer &amp; Systems Architect</p>
        <p class="hero-desc">
          I build high-performance distributed systems, APIs, and infrastructure
          that scale. Obsessed with correctness, latency, and clean abstractions.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn-primary mono">[VIEW WORK ->]</a>
          <a href="#contact"  class="btn-ghost mono">[GET IN TOUCH]</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-num">4+</span>
            <span class="stat-label mono">YRS EXP</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">30+</span>
            <span class="stat-label mono">PROJECTS</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">99.9%</span>
            <span class="stat-label mono">UPTIME</span>
          </div>
        </div>
        <div class="hero-arrow">
          <DoubleArrow label="SCROLL" direction="horizontal" />
        </div>
      </div>
    </CrossPattern>

    <!-- ══════════════════════════════════════════════════════════
         ABOUT — GradientBackground
    ═══════════════════════════════════════════════════════════ -->
    <GradientBackground variant="linear-br" blur={50} class="section" id="about">
      <div class="container">
        <div class="section-header">
          <span class="mono label">02 :: ABOUT</span>
          <div class="section-line"></div>
        </div>
        <div class="about-grid">
          <div class="about-text">
            <h2 class="section-title">Engineering<br />Rigor.</h2>
            <p class="body-text">
              I'm a backend engineer focused on building systems that are fast,
              reliable, and maintainable. My work spans API design, database
              architecture, distributed systems, and DevOps automation.
            </p>
            <p class="body-text">
              I believe software should feel like a well-engineered machine —
              every component purposeful, every interface deliberate. No fluff,
              no magic, just clean logic and measurable outcomes.
            </p>
            <div class="about-links">
              <a href="#" class="text-link mono">[RESUME ->]</a>
              <a href="#" class="text-link mono">[GITHUB ->]</a>
              <a href="#" class="text-link mono">[LINKEDIN ->]</a>
            </div>
          </div>
          <div class="about-sidebar">
            <div class="info-block">
              <span class="mono label">LOCATION</span>
              <span class="info-value">Philippines</span>
            </div>
            <div class="info-block">
              <span class="mono label">FOCUS</span>
              <span class="info-value">Backend / Infra</span>
            </div>
            <div class="info-block">
              <span class="mono label">STACK</span>
              <span class="info-value">Node · Go · Postgres</span>
            </div>
            <div class="info-block">
              <span class="mono label">STATUS</span>
              <span class="info-value available">Open to roles</span>
            </div>
            <div class="about-photo">
              <ImagePlaceholder width="100%" height="240px" label="PHOTO" bracketSize={20} />
              <DoubleArrow label="280px" direction="horizontal" class="about-measure" />
            </div>
          </div>
        </div>
      </div>
    </GradientBackground>

    <!-- ══════════════════════════════════════════════════════════
         PROJECTS — GridPattern
    ═══════════════════════════════════════════════════════════ -->
    <GridPattern cellSize={48} lineWidth={1} fade={0.7} class="section" id="projects">
      <div class="container">
        <div class="section-header">
          <span class="mono label">03 :: PROJECTS</span>
          <div class="section-line"></div>
        </div>
        <h2 class="section-title">Selected<br />Work.</h2>
        <div class="projects-grid">

          <div class="project-card featured">
            <div class="card-header">
              <span class="mono label">PROJECT_01 :: FEATURED</span>
              <span class="card-tag mono">Go · Postgres · Redis</span>
            </div>
            <h3 class="card-title">Distributed Task Queue</h3>
            <p class="card-desc">
              High-throughput job processing engine handling 50k+ tasks/sec.
              Built-in retry logic, dead-letter queues, and real-time monitoring.
            </p>
            <div class="card-metrics">
              <span class="metric mono">50K RPS</span>
              <span class="metric mono">P99 &lt; 2ms</span>
              <span class="metric mono">99.99% UPTIME</span>
            </div>
            <div class="card-footer">
              <a href="#" class="text-link mono">[VIEW CODE ->]</a>
              <a href="#" class="text-link mono">[CASE STUDY ->]</a>
            </div>
          </div>

          <div class="project-card">
            <div class="card-header">
              <span class="mono label">PROJECT_02</span>
              <span class="card-tag mono">Node · GraphQL · AWS</span>
            </div>
            <h3 class="card-title">API Gateway</h3>
            <p class="card-desc">
              Unified GraphQL gateway aggregating 12 microservices with
              schema stitching, rate limiting, and request tracing.
            </p>
            <div class="card-footer">
              <a href="#" class="text-link mono">[VIEW CODE ->]</a>
            </div>
          </div>

          <div class="project-card">
            <div class="card-header">
              <span class="mono label">PROJECT_03</span>
              <span class="card-tag mono">Python · Terraform · K8s</span>
            </div>
            <h3 class="card-title">Infra Automation</h3>
            <p class="card-desc">
              IaC pipeline reducing deployment time from 45 minutes to 4.
              Full GitOps workflow with automated rollback on failure.
            </p>
            <div class="card-footer">
              <a href="#" class="text-link mono">[VIEW CODE ->]</a>
            </div>
          </div>

          <div class="project-card">
            <div class="card-header">
              <span class="mono label">PROJECT_04</span>
              <span class="card-tag mono">Rust · gRPC · Kafka</span>
            </div>
            <h3 class="card-title">Event Stream Processor</h3>
            <p class="card-desc">
              Real-time event processing pipeline with exactly-once semantics,
              schema registry, and consumer group management.
            </p>
            <div class="card-footer">
              <a href="#" class="text-link mono">[VIEW CODE ->]</a>
            </div>
          </div>

        </div>
      </div>
    </GridPattern>

    <!-- ══════════════════════════════════════════════════════════
         SKILLS — DotPattern
    ═══════════════════════════════════════════════════════════ -->
    <DotPattern spacing={28} dotSize={1.5} fade={0.6} class="section" id="skills">
      <div class="container">
        <div class="section-header">
          <span class="mono label">04 :: SKILLS</span>
          <div class="section-line"></div>
        </div>
        <h2 class="section-title">Tech<br />Stack.</h2>
        <div class="skills-grid">

          <div class="skill-group">
            <span class="mono label skill-group-label">LANGUAGES</span>
            <div class="skill-list">
              {['Go', 'TypeScript', 'Python', 'Rust', 'SQL', 'Bash'].map(s => (
                <span class="skill-tag mono">{s}</span>
              ))}
            </div>
          </div>

          <div class="skill-group">
            <span class="mono label skill-group-label">DATABASES</span>
            <div class="skill-list">
              {['PostgreSQL', 'Redis', 'MongoDB', 'ClickHouse', 'Elasticsearch'].map(s => (
                <span class="skill-tag mono">{s}</span>
              ))}
            </div>
          </div>

          <div class="skill-group">
            <span class="mono label skill-group-label">INFRASTRUCTURE</span>
            <div class="skill-list">
              {['Kubernetes', 'Docker', 'Terraform', 'AWS', 'GCP', 'Nginx'].map(s => (
                <span class="skill-tag mono">{s}</span>
              ))}
            </div>
          </div>

          <div class="skill-group">
            <span class="mono label skill-group-label">PROTOCOLS & PATTERNS</span>
            <div class="skill-list">
              {['REST', 'GraphQL', 'gRPC', 'Kafka', 'WebSockets', 'CQRS'].map(s => (
                <span class="skill-tag mono">{s}</span>
              ))}
            </div>
          </div>

        </div>
      </div>
    </DotPattern>

    <!-- ══════════════════════════════════════════════════════════
         CONTACT — CrossPattern (different seed)
    ═══════════════════════════════════════════════════════════ -->
    <CrossPattern count={32} seed={99} fade={0.7} class="section" id="contact">
      <div class="container contact-inner">
        <div class="section-header">
          <span class="mono label">05 :: CONTACT</span>
          <div class="section-line"></div>
        </div>
        <h2 class="section-title">Let's<br />Build.</h2>
        <p class="body-text contact-desc">
          Open to full-time roles, contract work, and interesting problems.
          If you're building something that needs to scale, let's talk.
        </p>
        <div class="contact-grid">
          <a href="mailto:hello@rycca.dev" class="contact-card">
            <span class="mono label">EMAIL</span>
            <span class="contact-value">hello@rycca.dev</span>
            <span class="mono arrow">[->]</span>
          </a>
          <a href="#" class="contact-card">
            <span class="mono label">GITHUB</span>
            <span class="contact-value">github.com/rycca</span>
            <span class="mono arrow">[->]</span>
          </a>
          <a href="#" class="contact-card">
            <span class="mono label">LINKEDIN</span>
            <span class="contact-value">linkedin.com/in/rycca</span>
            <span class="mono arrow">[->]</span>
          </a>
        </div>
      </div>
    </CrossPattern>

    <!-- ── FOOTER ────────────────────────────────────────────── -->
    <footer class="footer">
      <span class="mono label">RYCCA BELCINA :: BACKEND ENGINEER :: {new Date().getFullYear()}</span>
      <span class="mono label footer-right">BUILT WITH ASTRO + MACHINE LOGIC</span>
    </footer>

  </body>
</html>

<script>
  // ── Blur transition ────────────────────────────────────────────
  // Strategy: commit the new theme class IMMEDIATELY when toggle fires.
  // CSS color transitions cross-fade over 600ms.
  // A backdrop-filter blur overlay runs on top for ~560ms, masking the
  // early part of the color transition. By the time the blur clears,
  // colors are already mid-interpolation — no hard snap, no flash.
  //
  // Timeline:
  //   0ms   — theme class committed + blur starts rising
  //   280ms — blur peaks (colors ~50% through transition)
  //   560ms — blur fully cleared (colors finish shortly after)

  const BLUR_PEAK     = 16;   // px
  const HALF_DURATION = 280;  // ms per phase

  function runBlurOverlay() {
    const overlay = document.createElement('div');
    overlay.style.cssText = `
      position: fixed;
      inset: 0;
      z-index: 99999;
      pointer-events: none;
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
      transition:
        backdrop-filter ${HALF_DURATION}ms cubic-bezier(0.4, 0, 0.2, 1),
        -webkit-backdrop-filter ${HALF_DURATION}ms cubic-bezier(0.4, 0, 0.2, 1);
    `;
    document.body.appendChild(overlay);

    // Phase 1 — blur up (two rAF ticks to ensure transition fires)
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        overlay.style.backdropFilter = `blur(${BLUR_PEAK}px)`;
        (overlay.style as unknown as Record<string, string>)['-webkit-backdrop-filter'] = `blur(${BLUR_PEAK}px)`;
      });
    });

    // Phase 2 — blur back down after peak
    setTimeout(() => {
      overlay.style.backdropFilter = 'blur(0px)';
      (overlay.style as unknown as Record<string, string>)['-webkit-backdrop-filter'] = 'blur(0px)';
      setTimeout(() => overlay.remove(), HALF_DURATION + 32);
    }, HALF_DURATION);
  }

  // ── Theme state ────────────────────────────────────────────────
  const toggle = document.getElementById('themeToggle') as HTMLButtonElement;
  const body   = document.getElementById('body') as HTMLElement;
  const nav    = document.getElementById('nav') as HTMLElement;

  // Restore from localStorage or system preference
  const stored = localStorage.getItem('ml-theme');
  let isLight = stored === 'light'
    ? true
    : stored === 'dark'
      ? false
      : window.matchMedia('(prefers-color-scheme: light)').matches;

  // Apply initial theme without animation
  function applyTheme(light: boolean, animate: boolean) {
    body.classList.toggle('light', light);
    document.documentElement.setAttribute('data-theme', light ? 'light' : 'dark');
    toggle.textContent = light ? '[LIGHT]' : '[DARK]';
    localStorage.setItem('ml-theme', light ? 'light' : 'dark');
    if (animate) runBlurOverlay();
  }

  applyTheme(isLight, false);

  let isAnimating = false;

  toggle.addEventListener('click', () => {
    if (isAnimating) return;
    isAnimating = true;
    isLight = !isLight;

    // 1. Commit theme immediately — CSS color transitions start now
    applyTheme(isLight, true);

    // Unlock after full transition
    setTimeout(() => { isAnimating = false; }, HALF_DURATION * 2 + 64);
  });

  // Shrink nav on scroll
  window.addEventListener('scroll', () => {
    nav.classList.toggle('nav--scrolled', window.scrollY > 40);
  }, { passive: true });
</script>

<style>
  /* ── Reset & base ──────────────────────────────────────────── */
  body {
    background-color: #121414;
    color: #e3e2e2;
    transition:
      background-color 600ms cubic-bezier(0.4, 0, 0.2, 1),
      color            600ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  body.light { background-color: #f4f4f4; color: #1a1a1a; }

  .mono { font-family: 'JetBrains Mono', monospace; }
  .label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8e9192;
  }
  body.light .label { color: #6e7070; }

  /* ── Container ─────────────────────────────────────────────── */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    width: 100%;
  }

  /* ── Section base ──────────────────────────────────────────── */
  .section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0;
    border-bottom: 1px solid #444748;
    background-color: #121414;
    transition:
      background-color 600ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color     600ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  body.light .section { background-color: #f4f4f4; border-bottom-color: #b8bbbc; }

  .section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 48px;
  }
  .section-line {
    flex: 1;
    height: 1px;
    background-color: #444748;
  }
  body.light .section-line { background-color: #b8bbbc; }

  .section-title {
    font-size: 56px;
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 48px;
  }
  body.light .section-title { color: #000000; }

  .body-text {
    font-size: 16px;
    line-height: 1.7;
    color: #c4c7c8;
    max-width: 560px;
    margin-bottom: 16px;
  }
  body.light .body-text { color: #3a3a3a; }
</style>

<style>
  /* ── NAV ───────────────────────────────────────────────────── */
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 56px;
    background-color: rgba(13, 14, 15, 0.92);
    border-bottom: 1px solid #444748;
    backdrop-filter: blur(8px);
    transition: height 0.2s, background-color 0.2s;
  }
  body.light .nav {
    background-color: rgba(244, 244, 244, 0.92);
    border-bottom-color: #b8bbbc;
  }
  .nav--scrolled { height: 44px; }

  .nav-logo {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: 0.08em;
  }
  body.light .nav-logo { color: #000000; }

  .nav-links { display: flex; gap: 32px; }
  .nav-link {
    font-size: 11px;
    color: #8e9192;
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.1s;
  }
  .nav-link:hover { color: #ffffff; }
  body.light .nav-link:hover { color: #000000; }

  .theme-btn {
    background: transparent;
    border: 1px solid #444748;
    color: #8e9192;
    padding: 4px 10px;
    cursor: pointer;
    font-size: 11px;
    letter-spacing: 0.06em;
    transition: background-color 0.1s, color 0.1s, border-color 0.1s;
  }
  .theme-btn:hover { background-color: #ffffff; border-color: #ffffff; color: #0d0e0f; }
  body.light .theme-btn:hover { background-color: #000000; border-color: #000000; color: #ffffff; }

  /* ── HERO ──────────────────────────────────────────────────── */
  .hero-section { padding-top: 56px; }
  .hero-inner { padding-top: 80px; padding-bottom: 80px; }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 32px;
  }
  .status-dot {
    width: 6px; height: 6px;
    background-color: #4ade80;
    display: inline-block;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }

  .hero-title {
    font-size: clamp(64px, 10vw, 120px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: 24px;
  }
  body.light .hero-title { color: #000000; }

  .hero-role {
    font-size: 13px;
    color: #8e9192;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .hero-desc {
    font-size: 18px;
    line-height: 1.6;
    color: #c4c7c8;
    max-width: 520px;
    margin-bottom: 40px;
  }
  body.light .hero-desc { color: #3a3a3a; }

  .hero-actions { display: flex; gap: 16px; margin-bottom: 64px; flex-wrap: wrap; }

  .btn-primary {
    display: inline-block;
    padding: 12px 24px;
    background-color: #ffffff;
    color: #0d0e0f;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.08em;
    font-weight: 700;
    transition: background-color 0.1s, color 0.1s;
  }
  .btn-primary:hover { background-color: #c4c7c8; }
  body.light .btn-primary { background-color: #000000; color: #ffffff; }
  body.light .btn-primary:hover { background-color: #343535; }

  .btn-ghost {
    display: inline-block;
    padding: 12px 24px;
    border: 1px solid #444748;
    color: #8e9192;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.08em;
    transition: border-color 0.1s, color 0.1s;
  }
  .btn-ghost:hover { border-color: #ffffff; color: #ffffff; }
  body.light .btn-ghost:hover { border-color: #000000; color: #000000; }

  .hero-stats { display: flex; align-items: center; gap: 32px; }
  .stat { display: flex; flex-direction: column; gap: 4px; }
  .stat-num { font-size: 32px; font-weight: 800; color: #ffffff; line-height: 1; }
  body.light .stat-num { color: #000000; }
  .stat-label { font-size: 10px; color: #444748; letter-spacing: 0.1em; }
  .stat-divider { width: 1px; height: 40px; background-color: #444748; }

  .hero-arrow {
    margin-top: 40px;
    max-width: 320px;
    opacity: 0.5;
  }
</style>

<style>
  /* ── ABOUT ─────────────────────────────────────────────────── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 80px;
    align-items: start;
  }

  .about-links { display: flex; gap: 24px; margin-top: 32px; flex-wrap: wrap; }
  .text-link {
    font-size: 11px;
    color: #8e9192;
    text-decoration: none;
    letter-spacing: 0.06em;
    border-bottom: 1px solid #444748;
    padding-bottom: 2px;
    transition: color 0.1s, border-color 0.1s;
  }
  .text-link:hover { color: #ffffff; border-color: #ffffff; }
  body.light .text-link:hover { color: #000000; border-color: #000000; }

  .about-sidebar { display: flex; flex-direction: column; gap: 0; }
  .info-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid #343535;
  }
  body.light .info-block { border-bottom-color: #d4d4d4; }
  .info-value { font-size: 15px; color: #e3e2e2; font-weight: 500; }
  body.light .info-value { color: #1a1a1a; }
  .available { color: #4ade80 !important; }

  .about-photo { margin-top: 24px; display: flex; flex-direction: column; gap: 8px; }
  .about-measure { opacity: 0.5; }

  /* ── PROJECTS ──────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background-color: #444748;
