---
import "../styles/error/500.css";
import {ROUTES} from "../config/routes";
---

<div class="error500">
    <div class="window500">
        <div class="content500">
            <h1>500 - Internal System Failure</h1>

            <p>
                The application encountered an unexpected error and cannot continue.
            </p>

            <br />
            <br />

            <p>
                Try the following:
            </p>

            <ul>
                <li>Refresh the page</li>
                <li>Return to the homepage</li>
                <li>Check system logs (if available)</li>
            </ul>

            <br />

            <a class="btn500" href={ROUTES.home}>Return to safety</a>

        </div>

    </div>
</div>