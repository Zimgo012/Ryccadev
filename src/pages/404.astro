---
import "../styles/error/404.css";
import "../styles/global.css"
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout webTitle="Not Found"/>
<div class="bsod">
    <div class="bsod-inner">
        <p class="bsod-title">A 404 ERROR EXCEPTION </p>

        <p>
            The page you are trying to access does not exist or has been moved.
        </p>

        <br />

        <p>
            * Press BACK in your browser to return to the previous page.<br />
            * If this is your first time seeing this error screen, restart your browser.<br />
            * If problems continue, check your URL or contact belcinajohnrycca@gmail.com.
        </p>

        <br />

    </div>
</div>